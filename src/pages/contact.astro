---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { CONTACT_EMAIL, SOCIAL_LINKS } from '~/consts';

const channels = (
  [
    ['github', 'GitHub', 'See our open source work and contribute.'],
    ['linkedin', 'LinkedIn', 'Follow updates and connect professionally.'],
    ['facebook', 'Facebook', 'Join the conversation in our group.'],
    ['x', 'X / Twitter', 'Quick announcements and discussions.'],
    ['youtube', 'YouTube', 'Workshops and recorded meetups.'],
  ] as const
)
  .map(([key, label, blurb]) => ({ key, label, blurb, href: SOCIAL_LINKS[key] }))
  .filter((c) => c.href && c.href.length > 0);
---

<BaseLayout
  title="Contact"
  description="Get in touch with the BAQC organizers, join our community channels, or send us an email. We respond to every message."
>
  <section class="contact container-x">
    <header class="contact__header">
      <h1>Get in touch</h1>
      <p class="contact__lede">
        BAQC is a community, not a company — and we love hearing from people who want to join,
        speak, write, or simply ask a question. Pick the channel that works best for you.
      </p>
    </header>

    <div class="contact__grid">
      <article class="contact__card surface">
        <h2>Email us</h2>
        <p>The fastest way to reach the organizers directly. We aim to reply within a few days.</p>
        <p>
          <a class="btn btn-primary" href={`mailto:${CONTACT_EMAIL}?subject=Hello%20BAQC`}>
            {CONTACT_EMAIL}
          </a>
        </p>
        <p class="contact__hint">
          Opens in your email client. We don't operate a contact form — your message goes straight
          to a real human inbox.
        </p>
      </article>

      <article class="contact__card surface">
        <h2>Find us online</h2>
        <p>Pick the platform you already use. We're on most of them.</p>
        <ul class="contact__channels">
          {
            channels.map((c) => (
              <li>
                <a href={c.href} rel="noopener me" target="_blank">
                  <strong>{c.label}</strong>
                  <span>{c.blurb}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </article>
    </div>

    <aside class="contact__cta surface">
      <h2>Want to contribute?</h2>
      <p>
        We're always looking for speakers, workshop leads, blog post writers, and event volunteers.
        Mention what you'd like to help with when you reach out — we move fast for people who want
        to make this community better.
      </p>
    </aside>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-block: 3rem 4rem;
    max-width: 1000px;
  }
  .contact__header {
    text-align: left;
    max-width: 60ch;
  }
  .contact__lede {
    margin-top: 1rem;
    font-size: 1.15rem;
    color: var(--color-ink-soft);
  }
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  .contact__card {
    padding: 1.75rem;
  }
  .contact__card h2 {
    margin: 0;
    font-size: 1.4rem;
  }
  .contact__card p {
    margin: 0.5rem 0 1rem;
    color: var(--color-ink-soft);
  }
  .contact__hint {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-top: 0.75rem;
  }
  .contact__channels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .contact__channels a {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-ink);
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .contact__channels a:hover {
    border-color: var(--color-brand-green-200);
    background: var(--color-paper-soft);
  }
  .contact__channels strong {
    font-weight: 600;
    color: var(--color-ink);
  }
  .contact__channels span {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-top: 2px;
  }
  .contact__cta {
    margin-top: 2rem;
    padding: 2rem;
    background: var(--color-brand-green-50);
    border-color: var(--color-brand-green-100);
  }
  .contact__cta h2 {
    margin: 0;
    color: var(--color-brand-green-900);
  }
  .contact__cta p {
    margin: 0.5rem 0 0;
    color: var(--color-brand-green-900);
    max-width: 65ch;
  }

  @media (max-width: 720px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
