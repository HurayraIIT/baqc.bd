---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for doesn't exist on baqc.bd. Head back home or browse the events and blog."
>
  <section class="not-found container-x">
    <p class="not-found__code">404</p>
    <h1>This page wandered off.</h1>
    <p class="not-found__lede">
      We couldn't find what you're looking for. Maybe it's been moved, renamed, or never existed in
      the first place. Try one of these instead:
    </p>
    <ul class="not-found__links">
      <li><a class="btn btn-primary" href="/">Go home</a></li>
      <li><a class="btn btn-secondary" href="/events">See events</a></li>
      <li><a class="btn btn-secondary" href="/blog">Read the blog</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: 5rem 6rem;
    max-width: 640px;
    text-align: center;
  }
  .not-found__code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 800;
    color: var(--color-brand-green);
    margin: 0;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .not-found h1 {
    margin: 1rem 0 0;
  }
  .not-found__lede {
    margin: 1rem auto 2rem;
    color: var(--color-ink-soft);
    max-width: 50ch;
  }
  .not-found__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
