---
import EventStatusBadge from './EventStatusBadge.astro';
import { formatEventDate, isUpcoming, type EventEntry } from '~/lib/events';

interface Props {
  entry: EventEntry;
}

const { entry } = Astro.props;
const { data } = entry;
const upcoming = isUpcoming(entry);
const href = `/events/${entry.id}`;
---

<a class="event-card surface" href={href}>
  <div class="event-card__head">
    <EventStatusBadge upcoming={upcoming} />
    <p class="event-card__when">
      <time datetime={data.startDate.toISOString()}>
        {formatEventDate(data.startDate, data.endDate)}
      </time>
    </p>
  </div>
  <h3 class="event-card__title">{data.title}</h3>
  <p class="event-card__where">
    {data.isOnline ? '🌐 Online' : `📍 ${data.location}`}{data.venue && ` — ${data.venue}`}
  </p>
  <p class="event-card__desc">{data.description}</p>
  <span class="event-card__cta" aria-hidden="true">View details →</span>
</a>

<style>
  .event-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    text-decoration: none;
    color: var(--color-ink);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }
  .event-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
    border-color: var(--color-brand-green-200);
  }
  .event-card__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
    flex-wrap: wrap;
  }
  .event-card__when {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin: 0;
  }
  .event-card__title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0.25rem 0 0;
    color: var(--color-ink);
  }
  .event-card__where {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
  }
  .event-card__desc {
    margin: 0.5rem 0 0;
    color: var(--color-ink-soft);
    line-height: 1.55;
    font-size: 0.95rem;
  }
  .event-card__cta {
    margin-top: 0.5rem;
    font-weight: 600;
    color: var(--color-brand-green-700);
    font-size: 0.9rem;
  }
</style>
