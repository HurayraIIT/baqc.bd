---
import {
  SITE_SHORT_TITLE,
  SITE_TITLE,
  SOCIAL_LINKS,
  FOOTER_LEGAL_LINKS,
  NAV_LINKS,
} from '~/consts';

const year = new Date().getFullYear();
const socials = (
  [
    ['github', 'GitHub'],
    ['linkedin', 'LinkedIn'],
    ['facebook', 'Facebook'],
    ['x', 'X'],
    ['youtube', 'YouTube'],
  ] as const
)
  .map(([key, label]) => ({ key, label, href: SOCIAL_LINKS[key] }))
  .filter((s) => s.href && s.href.length > 0);
---

<footer class="site-footer">
  <div class="container-x site-footer__grid">
    <div class="site-footer__brand">
      <p class="site-footer__name">{SITE_SHORT_TITLE}</p>
      <p class="site-footer__tag">{SITE_TITLE}</p>
      <p class="site-footer__blurb">
        A volunteer-run community for aspiring and early-career quality engineers in Bangladesh.
      </p>
    </div>
    <nav class="site-footer__col" aria-label="Footer navigation">
      <h2>Site</h2>
      <ul>
        {
          NAV_LINKS.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav class="site-footer__col" aria-label="Legal">
      <h2>Legal</h2>
      <ul>
        {
          FOOTER_LEGAL_LINKS.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav class="site-footer__col" aria-label="Social">
      <h2>Connect</h2>
      <ul>
        {
          socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener" target="_blank">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="container-x site-footer__base">
    <p>© {year} {SITE_TITLE}. Built by the community.</p>
    <p>
      <a href="https://github.com/baqc-bd" rel="noopener" target="_blank">Source on GitHub</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    padding: 3rem 0 1.5rem;
    background: var(--color-paper-soft);
    border-top: 1px solid var(--color-line);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2rem;
  }
  .site-footer__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    margin: 0;
  }
  .site-footer__tag {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin: 0.15rem 0 0.75rem;
  }
  .site-footer__blurb {
    font-size: 0.95rem;
    color: var(--color-ink-soft);
    max-width: 40ch;
    margin: 0;
  }
  .site-footer__col h2 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin: 0 0 0.75rem;
    font-family: var(--font-sans);
    font-weight: 700;
  }
  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .site-footer__col a {
    color: var(--color-ink-soft);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .site-footer__col a:hover {
    color: var(--color-brand-green-700);
    text-decoration: underline;
  }
  .site-footer__base {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .site-footer__base a {
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
